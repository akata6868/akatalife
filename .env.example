# ==============================================================================
# AKATA LIFE — ENVIRONMENT TEMPLATE (.env.example)
# Copy to .env for local development. NEVER commit .env to Git.
# ==============================================================================

# 1. Database (PostgreSQL)
DATABASE_URL="postgresql://akata:CHANGE_ME_LOCAL_DEV_ONLY@localhost:5432/akatalife?schema=public"
POSTGRES_USER="akata"
POSTGRES_PASSWORD="CHANGE_ME_LOCAL_DEV_ONLY"
POSTGRES_DB="akatalife"

# 2. Application & Session Security
# Generate with: openssl rand -hex 32
SESSION_SECRET="REPLACE_WITH_64_HEX_CHARACTER_CRYPTOGRAPHIC_SECRET"
ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARACTER_KEY_FOR_TOTP_AND_TOKENS"
APP_URL="http://localhost:3000"
DEFAULT_LOCALE="de"
TZ="Europe/Berlin"

# 3. Initial Owner Bootstrap (Only used by explicit setup/seed command, never hardcoded)
INITIAL_OWNER_EMAIL=""
INITIAL_OWNER_PASSWORD=""
INITIAL_OWNER_NAME=""

# 4. Private Document Storage (Must reside outside public/ directory)
STORAGE_DIR="./storage/uploads"
MAX_UPLOAD_BYTES="26214400" # 25 MB

# 5. Optional Home Assistant Read-Only Integration (Disabled by default)
HOME_ASSISTANT_ENABLED="false"
HOME_ASSISTANT_URL=""
HOME_ASSISTANT_TOKEN=""
HOME_ASSISTANT_TIMEOUT_MS="5000"
