# ==============================================================================
# AKATA LIFE — ENVIRONMENT TEMPLATE (.env.example)
# Configure these variables in Coolify (Production) or .env (Local Dev).
# NEVER commit real secrets or .env to GitHub.
# ==============================================================================

# 1. Supabase PostgreSQL Database
# DATABASE_URL: Transaction pooler (port 6543, ?pgbouncer=true) or direct connection
# DIRECT_URL: Session mode / direct connection (port 5432) used by Prisma Migrations
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Optional Supabase Storage (if using Supabase Storage bucket instead of Coolify persistent volume)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="akatalife-documents"

# 2. Application & Session Security
# Generate with: openssl rand -hex 32
SESSION_SECRET="REPLACE_WITH_64_HEX_CHARACTER_CRYPTOGRAPHIC_SECRET"
ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARACTER_KEY_FOR_TOTP_AND_TOKENS"
APP_URL="http://localhost:3000"
DEFAULT_LOCALE="de"
TZ="Europe/Berlin"

# 3. Hermes Agent Full API Access
# Generate with: openssl rand -hex 32
# Hermes Agent authenticates via: Authorization: Bearer <HERMES_AGENT_API_KEY>
HERMES_AGENT_ENABLED="true"
HERMES_AGENT_API_KEY="REPLACE_WITH_HIGH_ENTROPY_HERMES_AGENT_SECRET_KEY"

# 4. Initial Owner Bootstrap (Used by setup/seed command or initial owner creation)
INITIAL_OWNER_EMAIL=""
INITIAL_OWNER_PASSWORD=""
INITIAL_OWNER_NAME="Süleyman Akata"

# 5. Private Document Storage (Coolify persistent volume path or local path)
STORAGE_DIR="./storage/uploads"
MAX_UPLOAD_BYTES="26214400" # 25 MB

# 6. Optional Home Assistant Read-Only Integration (Disabled by default)
HOME_ASSISTANT_ENABLED="false"
HOME_ASSISTANT_URL=""
HOME_ASSISTANT_TOKEN=""
HOME_ASSISTANT_TIMEOUT_MS="5000"
