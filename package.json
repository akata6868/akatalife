{
  "name": "akata-life",
  "version": "0.1.0",
  "private": true,
  "description": "Akata Life — Private Household, Contract, Finance, Document & Home Management Platform (Coolify + Supabase + Hermes Agent)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"prisma/**/*.prisma\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "4.1.3",
    "@prisma/client": "6.5.0",
    "clsx": "2.1.1",
    "lucide-react": "0.483.0",
    "next": "15.2.3",
    "otpauth": "9.3.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "recharts": "2.15.1",
    "tailwind-merge": "3.0.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.22.0",
    "eslint-config-next": "15.2.3",
    "postcss": "8.5.3",
    "prettier": "3.5.3",
    "prisma": "6.5.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.0.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
